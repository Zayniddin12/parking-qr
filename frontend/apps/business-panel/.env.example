# AutoParking — Business Panel (cloud-served, operator self-service).
# Copy to .env.local and adjust for your environment.

# --- API planes -----------------------------------------------------------
# Management plane (Python/FastAPI) — CRUD/reporting. Base must include /v1.
# Local docker compose publishes management on host :8000.
VITE_MANAGEMENT_API_URL=http://localhost:8000/v1
# Core plane (Go) — payments, governance, SSE ledger. Local compose: host :8080.
VITE_CORE_API_URL=http://localhost:8080

# --- OIDC / Keycloak (phase-1 auth contract) ------------------------------
# Local dev realm. These are the defaults baked into @autoparking/auth, listed
# here so prod/staging can override without code changes. NOTHING here is secret
# (public SPA client, PKCE S256 — no client secret).
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/autoparking
VITE_OIDC_CLIENT_ID=autoparking-web
# Redirect back to this app. Must match a redirect URI registered on the client
# (http://localhost:5173/* and :5174). Defaults to window.location.origin + '/'.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_SCOPE=openid profile email
